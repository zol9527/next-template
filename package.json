{
  "name": "next-template-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "通用全栈 monorepo 模板，统一管理后端、Web、桌面端、小程序和未来移动端应用。",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "apps/miniprograms/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @repo/backend dev",
    "dev:backend": "bun run --filter @repo/backend dev",
    "dev:miniprogram:wechat": "bun run --filter @repo/miniprogram-wechat dev",
    "dev:wechat": "bun run --filter @repo/miniprogram-wechat dev",
    "build": "bun run --filter @repo/backend build",
    "build:backend": "bun run --filter @repo/backend build",
    "build:miniprogram:wechat": "bun run --filter @repo/miniprogram-wechat build",
    "build:wechat": "bun run --filter @repo/miniprogram-wechat build",
    "compile:miniprogram:wechat": "bun run --filter @repo/miniprogram-wechat compile:mp-weixin",
    "compile:wechat": "bun run --filter @repo/miniprogram-wechat compile:mp-weixin",
    "watch:miniprogram:wechat": "bun run --filter @repo/miniprogram-wechat watch:mp-weixin",
    "watch:wechat": "bun run --filter @repo/miniprogram-wechat watch:mp-weixin",
    "lint": "bun run --filter @repo/backend lint",
    "test": "bun run --filter @repo/backend test",
    "test:backend": "bun run --filter @repo/backend test",
    "test:miniprogram:wechat": "bun run --filter @repo/miniprogram-wechat test",
    "test:wechat": "bun run --filter @repo/miniprogram-wechat test"
  },
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  }
}
