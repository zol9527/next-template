{
  "name": "shuoboda-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "书博达业务系统 monorepo，统一管理后端、Web、桌面端、小程序和未来移动端应用。",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @shuoboda/backend",
    "dev:backend": "npm run dev -w @shuoboda/backend",
    "dev:miniprogram": "npm run dev -w @shuoboda/miniprogram",
    "build": "npm run build -w @shuoboda/backend",
    "build:backend": "npm run build -w @shuoboda/backend",
    "build:miniprogram": "npm run build -w @shuoboda/miniprogram",
    "compile:miniprogram": "npm run compile:mp-weixin -w @shuoboda/miniprogram",
    "watch:miniprogram": "npm run watch:mp-weixin -w @shuoboda/miniprogram",
    "lint": "npm run lint -w @shuoboda/backend",
    "test": "npm run test -w @shuoboda/backend",
    "test:backend": "npm run test -w @shuoboda/backend",
    "test:miniprogram": "npm run test -w @shuoboda/miniprogram"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
