{
  "name": "next-template-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "通用全栈 monorepo 模板，统一管理后端、Web、桌面端、小程序和未来移动端应用。",
  "workspaces": [
    "apps/*",
    "apps/miniprograms/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @repo/backend",
    "dev:backend": "npm run dev -w @repo/backend",
    "dev:miniprogram:wechat": "npm run dev -w @repo/miniprogram-wechat",
    "dev:wechat": "npm run dev -w @repo/miniprogram-wechat",
    "build": "npm run build -w @repo/backend",
    "build:backend": "npm run build -w @repo/backend",
    "build:miniprogram:wechat": "npm run build -w @repo/miniprogram-wechat",
    "build:wechat": "npm run build -w @repo/miniprogram-wechat",
    "compile:miniprogram:wechat": "npm run compile:mp-weixin -w @repo/miniprogram-wechat",
    "compile:wechat": "npm run compile:mp-weixin -w @repo/miniprogram-wechat",
    "watch:miniprogram:wechat": "npm run watch:mp-weixin -w @repo/miniprogram-wechat",
    "watch:wechat": "npm run watch:mp-weixin -w @repo/miniprogram-wechat",
    "lint": "npm run lint -w @repo/backend",
    "test": "npm run test -w @repo/backend",
    "test:backend": "npm run test -w @repo/backend",
    "test:miniprogram:wechat": "npm run test -w @repo/miniprogram-wechat",
    "test:wechat": "npm run test -w @repo/miniprogram-wechat"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
