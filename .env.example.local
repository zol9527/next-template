# 本地开发环境变量示例
# 将此文件复制到 .env.development（本地开发推荐）并填写实际值。
#
# 重要提示：
# - 不要提交 .env（包含密钥）
# - 此示例文件可以安全提交（不包含真实密钥）

NODE_ENV=development

# --- 数据库（本地开发默认使用 Prisma + MySQL） ---
# 推荐默认值：
#   DATABASE_PROVIDER=prisma
#   DATABASE_URL=mysql://user:password@127.0.0.1:3306/edu_mini_app
#
# 说明：
# - 当前 Prisma 链路统一使用 MySQL/MariaDB
# - 想切换到 Supabase 时，将 DATABASE_PROVIDER 改为 supabase，并配置下方 SUPABASE_* 变量
DATABASE_PROVIDER=prisma
DATABASE_URL=mysql://root:password@127.0.0.1:3306/edu_mini_app

# --- 认证 (认证接口所需) ---
# 必须 >= 32 字符
AUTH_JWT_ACCESS_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHARS_OR_MORE_SECRET
# 必须 >= 32 字符
AUTH_REFRESH_TOKEN_PEPPER=CHANGE_ME_TO_A_RANDOM_32_CHARS_OR_MORE_SECRET

AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=1296000
AUTH_MAX_SESSIONS_PER_USER=3
AUTH_LOGIN_LOCK_THRESHOLD=10
AUTH_LOGIN_LOCK_DURATION_SECONDS=600

# Cookie/CORS
AUTH_COOKIE_SAMESITE=lax
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 可选
# AUTH_COOKIE_DOMAIN=

# --- Supabase (访问 /api/v1/auth/* 所需) ---
# 本地 Supabase 默认地址 (supabase start): http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=sb_secret_CHANGE_ME

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_CHANGE_ME

# --- 微信 (访问 /api/v1/auth/wechat 所需) ---
WECHAT_APPID=
WECHAT_APPSECRET=
# session_key 加密密钥（必须 >= 32 字符）
WECHAT_SESSION_KEY_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_32_CHARS_OR_MORE_SECRET

# --- 微信支付 (小程序支付/回调所需) ---
# 小程序支付 appid（可为空，默认回退 WECHAT_APPID）
WECHAT_PAY_APPID=
# 微信支付商户号
WECHAT_PAY_MCHID=
# APIv3 密钥
WECHAT_PAY_API_V3_KEY=
# 商户 API 证书序列号（用于请求微信支付接口签名）
WECHAT_PAY_CERT_SERIAL=
# 商户 API 私钥 PEM（支持用 \n 存储）
WECHAT_PAY_PRIVATE_KEY_PEM=
# 微信支付公钥 PEM（公钥模式，支持用 \n 存储）
WECHAT_PAY_PUBLIC_KEY=
# 微信支付公钥ID（通常形如 PUB_KEY_ID_xxx，对应回调头 Wechatpay-Serial）
WECHAT_PAY_PUBLIC_KEY_ID=
# 微信支付公钥列表（可选，JSON 数组；用于证书/公钥轮换）
# 例如: [{"serial":"PUB_KEY_ID_1","publicKeyPem":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"}]
WECHAT_PAY_PUBLIC_KEYS_JSON=
# 支付成功回调地址
WECHAT_PAY_NOTIFY_URL=

# --- 初始管理员种子数据 ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- 企业级日志 ---
# 日志级别阈值: debug | info | warn | error
LOG_LEVEL=debug
# 本地日志目录
LOG_DIR=./logs
# 默认为 false: 避免与 Next.js 输出混淆
LOG_TO_STDOUT=false
# 轮转: 大小 + 每日
LOG_ROTATE_SIZE_BYTES=10485760
LOG_ROTATE_DAILY=true
# 保留: 天数 + 总大小
LOG_RETENTION_DAYS=7
LOG_RETENTION_MAX_TOTAL_BYTES=1073741824
# 是否记录详细 HTTP 请求/响应内容（含脱敏）
LOG_HTTP_DETAILS_ENABLED=false

# ==================== MFA Configuration ====================

# MFA 加密密钥（用于加密 mfaSecret）
# 生成方式：openssl rand -base64 32
MFA_SECRET_ENCRYPTION_KEY=CHANGE_ME_TO_A_RANDOM_32_CHARS_OR_MORE_SECRET

# TOTP 配置
TOTP_SERVICE_NAME="GenericAdmin"           # 在 Authenticator 中显示的名称
TOTP_ISSUER="GenericAdmin Admin"           # 发行者
TOTP_DIGITS=6                              # 验证码位数
TOTP_STEP=30                               # 时间窗口（秒）

# Action Token 配置
MFA_ACTION_TOKEN_TTL=300                   # 一次性令牌有效期（秒），默认 5 分钟

# ==================== Rate Limit Configuration ====================

# Rate Limit 系统配置
# 动态配置系统支持数据库存储，可分布式部署，数据库不可用时降级到内存

# 是否信任反向代理的 IP 头（X-Forwarded-For, X-Real-IP）
# - 生产环境如果有 Nginx/Cloudflare 等反向代理，建议设为 true
# - 开发环境通常设为 false
RATE_LIMIT_TRUST_PROXY=false

# 是否允许内网 IP（如 192.168.x.x, 10.x.x.x）
# - 生产环境建议设为 false，防止内网攻击
# - 开发环境可以设为 true
RATE_LIMIT_ALLOW_PRIVATE_IP=false

# 是否要求必须有 IP（无法获取时拒绝请求）
# - 建议设为 true，增强安全性
# - 设为 false 时，无 IP 请求会被放行（不推荐）
RATE_LIMIT_REQUIRE_IP=true

# ==================== Plugin Configuration ====================

# --- 插件开关 ---
# 控制各业务插件的启用/禁用状态
PLUGIN_WECHAT=false
PLUGIN_ECOMMERCE=false
PLUGIN_PROMOTION=false
