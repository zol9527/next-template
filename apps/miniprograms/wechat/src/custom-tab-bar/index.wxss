/* Custom TabBar Styles */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(124rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 12rpx 16rpx calc(12rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 9999;
  border-top: 2rpx solid rgba(226, 235, 237, 0.35);
  box-sizing: border-box;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  min-width: 0;
  margin: 0 4rpx;
  padding: 12rpx 0;
  border-radius: 24rpx;
  position: relative;
  color: #6B8A94;
  transition: background-color 0.2s ease, color 0.2s ease;
  box-sizing: border-box;
}

.tab-bar-item.active {
  background-color: #E8F7F0;
  color: #009666;
}

.tab-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tab-icon-image {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.tab-label {
  max-width: 100%;
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 24rpx;
  color: #6B8A94;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tab-bar-item.active .tab-label {
  color: #009666;
}
