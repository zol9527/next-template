{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^NavBar$": "@/components/NavBar.vue"
		}
	},
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "硕博达",
				"navigationStyle": "custom",
				"disableScroll": false,
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "登录",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/shop/shop",
			"style": {
				"navigationBarTitleText": "商城",
				"navigationStyle": "custom",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/orders/orders",
			"style": {
				"navigationBarTitleText": "订单",
				"navigationStyle": "custom",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/profile/profile",
			"style": {
				"navigationBarTitleText": "我的",
				"navigationStyle": "custom"
			}
		}
	],
	"subPackages": [
		{
			"root": "subpackages/agreements",
			"name": "agreements",
			"pages": [
				{
					"path": "detail",
					"style": {
						"navigationBarTitleText": "协议",
						"navigationStyle": "custom"
					}
				}
			]
		},
		{
			"root": "subpackages/product",
			"name": "product",
			"pages": [
				{
					"path": "detail",
					"style": {
						"navigationBarTitleText": "商品详情",
						"navigationStyle": "custom"
					}
				}
			]
		},
		{
			"root": "subpackages/orders-detail",
			"name": "orders-detail",
			"pages": [
				{
					"path": "detail",
					"style": {
						"navigationBarTitleText": "订单详情",
						"navigationStyle": "custom"
					}
				}
			]
		},
		{
			"root": "subpackages/promotion",
			"name": "promotion",
			"pages": [
				{
					"path": "center",
					"style": {
						"navigationBarTitleText": "推广中心",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "codes",
					"style": {
						"navigationBarTitleText": "我的推广码",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "commissions",
					"style": {
						"navigationBarTitleText": "佣金记录",
						"navigationStyle": "custom"
					}
				}
			]
		},
		{
			"root": "subpackages/profile",
			"name": "profile",
			"pages": [
				{
					"path": "complete",
					"style": {
						"navigationBarTitleText": "完善个人信息",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "my-courses/index",
					"style": {
						"navigationBarTitleText": "我的课程",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "favorites/index",
					"style": {
						"navigationBarTitleText": "我的收藏",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "invite/index",
					"style": {
						"navigationBarTitleText": "邀请好友",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "coupons/index",
					"style": {
						"navigationBarTitleText": "优惠券",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "feedback-history/index",
					"style": {
						"navigationBarTitleText": "我的反馈",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "feedback-detail/index",
					"style": {
						"navigationBarTitleText": "反馈详情",
						"navigationStyle": "custom"
					}
				}
			]
		},
		{
			"root": "subpackages/user-documents",
			"name": "user-documents",
			"pages": [
				{
					"path": "index",
					"style": {
						"navigationBarTitleText": "我的证件",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "upload",
					"style": {
						"navigationBarTitleText": "上传证件",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "preview",
					"style": {
						"navigationBarTitleText": "证件预览",
						"navigationStyle": "custom"
					}
				}
			]
		},
		{
			"root": "subpackages/settings",
			"name": "settings",
			"pages": [
				{
					"path": "index",
					"style": {
						"navigationBarTitleText": "设置",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "account-security/index",
					"style": {
						"navigationBarTitleText": "账号安全",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "privacy-settings/index",
					"style": {
						"navigationBarTitleText": "隐私设置",
						"navigationStyle": "custom"
					}
				}
			]
		},
		{
			"root": "subpackages/search",
			"name": "search",
			"pages": [
				{
					"path": "index",
					"style": {
						"navigationBarTitleText": "搜索",
						"navigationStyle": "custom"
					}
				}
			]
		},
		{
			"root": "subpackages/checkin",
			"name": "checkin",
			"pages": [
				{
					"path": "index",
					"style": {
						"navigationBarTitleText": "每日签到",
						"navigationStyle": "custom",
						"enablePullDownRefresh": true
					}
				}
			]
		},
		{
			"root": "subpackages/about",
			"name": "about",
			"pages": [
				{
					"path": "help-feedback/index",
					"style": {
						"navigationBarTitleText": "帮助与反馈",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "about/index",
					"style": {
						"navigationBarTitleText": "关于我们",
						"navigationStyle": "custom"
					}
				}
			]
		},
		{
			"root": "subpackages/notifications",
			"name": "notifications",
			"pages": [
				{
					"path": "index",
					"style": {
						"navigationBarTitleText": "通知中心",
						"navigationStyle": "custom",
						"enablePullDownRefresh": true
					}
				},
				{
					"path": "detail",
					"style": {
						"navigationBarTitleText": "通知详情",
						"navigationStyle": "custom"
					}
				}
			]
		}
	],
	"preloadRule": {
		"pages/shop/shop": {
			"network": "all",
			"packages": ["product"]
		},
		"pages/orders/orders": {
			"network": "all",
			"packages": ["orders-detail"]
		},
		"pages/profile/profile": {
			"network": "all",
			"packages": ["profile", "promotion", "user-documents", "settings", "about"]
		},
		"pages/index/index": {
			"network": "all",
			"packages": ["search", "notifications"]
		}
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "Plantify",
		"navigationBarBackgroundColor": "#FFFFFF",
		"backgroundColor": "#FFFFFF"
	},
	"tabBar": {
		"custom": true,
		"color": "#4F6C7B",
		"selectedColor": "#009666",
		"borderStyle": "black",
		"backgroundColor": "#FFFFFF",
		"list": [
			{
				"pagePath": "pages/index/index",
				"text": "首页"
			},
			{
				"pagePath": "pages/shop/shop",
				"text": "商城"
			},
			{
				"pagePath": "pages/orders/orders",
				"text": "订单"
			},
			{
				"pagePath": "pages/profile/profile",
				"text": "我的"
			}
		]
	},
	"uniIdRouter": {}
}
