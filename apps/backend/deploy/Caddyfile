# Caddy 配置文件 - 教育电商平台
#
# 功能:
#   - 自动 HTTPS (Let's Encrypt)
#   - 反向代理到 Next.js 应用
#   - 静态文件缓存
#   - 安全头部配置
#
# 日志策略:
#   应用层日志由 Pino 管理（结构化 JSON，按日期/大小滚动），Caddy 不重复记录。
#   如需排查反向代理层问题，可临时添加 log {} 块。
#
# 部署位置: /etc/caddy/Caddyfile (或通过 caddy import 管理)
#
# 使用方式:
#   1. 将此文件内容复制到服务器的 Caddyfile
#   2. 或使用: caddy add-package --github caddy-dns/cloudflare (如需 DNS 验证)
#   3. 重载: make caddy-reload ENV=production

# ============== 生产环境配置 ==============
# 将 www.shuoboda.cn 替换为你的真实域名

# 显式强制 HTTP -> HTTPS
http://www.shuoboda.cn {
        redir https://www.shuoboda.cn{uri} 308
}

https://www.shuoboda.cn {
        # HTTPS 响应压缩
        encode zstd gzip

        # 安全头部
        header {
                # 安全头部建议由应用层（Next.js）统一下发，避免与 next.config.ts 重复/覆盖。
                # 这里仅移除 Server 信息。
                -Server
        }

        # Next.js 静态资源缓存
        handle /_next/static/* {
                reverse_proxy localhost:3000
                header Cache-Control "public, max-age=31536000, immutable"
        }

        handle /static/* {
                reverse_proxy localhost:3000
                header Cache-Control "public, max-age=86400"
        }

        handle /images/* {
                reverse_proxy localhost:3000
                header Cache-Control "public, max-age=86400"
        }

        # favicon 等根目录资源
        @root_assets path /favicon.ico /robots.txt /sitemap.xml
        handle @root_assets {
                reverse_proxy localhost:3000
                header Cache-Control "public, max-age=86400"
        }

	# ──────────────────────────────────────────────────────────
	# 本地存储的公开文件（图片/视频等）
	# 代理到 Node.js 但不覆盖缓存头，由应用层 Route Handler 控制。
	# 必须在 /api/* 之前匹配，否则 no-store 会覆盖 immutable。
	# ──────────────────────────────────────────────────────────
	handle /api/v1/public/files/* {
		reverse_proxy localhost:3000
		header {
			# 纵深防御：即使应用层遗漏，Caddy 层也阻止 MIME 嗅探
			X-Content-Type-Options nosniff
			-Server
		}
	}

	# ──────────────────────────────────────────────────────────
	# 💡 最高性能方案：让 Caddy 直接提供 uploads 目录的静态文件
	#
	# 如果使用 local 存储模式，可以在服务器上配置 Caddy 直接
	# 提供 uploads 目录，完全绕过 Node.js。
	#
	# 步骤：
	# 1. 设置 LOCAL_UPLOAD_HOST=https://your-domain.com/static-files
	# 2. 在 Caddyfile 中添加以下 handle（放在 /api/* 之前）：
	#
	# handle /static-files/* {
	# 	root * /path/to/apps/backend/uploads
	# 	rewrite strip /static-files
	# 	file_server {
	# 		precompressed br gzip
	# 		etag
	# 	}
	# 	header Cache-Control "public, max-age=31536000, immutable"
	# }
	# ──────────────────────────────────────────────────────────

	# API 路由 (无缓存)
	# 注意：不包含 /api/v1/public/files/*（已在上方单独处理）
	handle /api/* {
		reverse_proxy localhost:3000
		header Cache-Control "no-store"
	}

        # Next.js 页面请求
        handle {
                reverse_proxy localhost:3000 {
                        # WebSocket 支持 (如开发场景需要)
                        header_up Upgrade {>Upgrade}
                        header_up Connection {>Connection}

                        # Caddy 会自动注入标准的 X-Forwarded-* 头，无需手动覆盖

                        # 超时配置
                        transport http {
                                dial_timeout 30s
                                response_header_timeout 60s
                        }
                }
        }
}
