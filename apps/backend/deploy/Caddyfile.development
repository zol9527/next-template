# Caddy 开发环境配置
#
# 域名: www.zolzeeezziiii.xyz
#
# 使用方式:
#   make caddy-start ENV=development
#   make caddy-reload ENV=development

# HTTP -> HTTPS 重定向
http://www.zolzeeezziiii.xyz {
	redir https://www.zolzeeezziiii.xyz{uri} 308
}

https://www.zolzeeezziiii.xyz {
	# HTTPS 响应压缩
	encode zstd gzip

	# 安全头部
	header {
		-Server
	}

	# Next.js 静态资源缓存
	handle /_next/static/* {
		reverse_proxy localhost:3000
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle /static/* {
		reverse_proxy localhost:3000
		header Cache-Control "public, max-age=86400"
	}

	handle /images/* {
		reverse_proxy localhost:3000
		header Cache-Control "public, max-age=86400"
	}

	# favicon 等根目录资源
	@root_assets path /favicon.ico /robots.txt /sitemap.xml
	handle @root_assets {
		reverse_proxy localhost:3000
		header Cache-Control "public, max-age=86400"
	}

	# ──────────────────────────────────────────────────────────
	# 本地存储的公开文件（图片/视频等）
	# 代理到 Node.js 但不覆盖缓存头，由应用层 Route Handler 控制。
	# 必须在 /api/* 之前匹配，否则 no-store 会覆盖 immutable。
	# ──────────────────────────────────────────────────────────
	handle /api/v1/public/files/* {
		reverse_proxy localhost:3000
		header {
			X-Content-Type-Options nosniff
			-Server
		}
	}

	# ──────────────────────────────────────────────────────────
	# 💡 最高性能方案：让 Caddy 直接提供 uploads 目录的静态文件
	#
	# 如果使用 local 存储模式，可以在服务器上配置 Caddy 直接
	# 提供 uploads 目录，完全绕过 Node.js。
	#
	# 步骤：
	# 1. 设置 LOCAL_UPLOAD_HOST=https://your-domain.com/static-files
	# 2. 在 Caddyfile 中添加以下 handle（放在 /api/* 之前）：
	#
	# handle /static-files/* {
	# 	root * /path/to/apps/backend/uploads
	# 	rewrite strip /static-files
	# 	file_server {
	# 		precompressed br gzip
	# 		etag
	# 	}
	# 	header Cache-Control "public, max-age=31536000, immutable"
	# }
	# ──────────────────────────────────────────────────────────

	# API 路由 (无缓存)
	# 注意：不包含 /api/v1/public/files/*（已在上方单独处理）
	handle /api/* {
		reverse_proxy localhost:3000
		header Cache-Control "no-store"
	}

	# Next.js 页面请求
	handle {
		reverse_proxy localhost:3000 {
			# WebSocket 支持
			header_up Upgrade {>Upgrade}
			header_up Connection {>Connection}

			# 超时配置
			transport http {
				dial_timeout 30s
				response_header_timeout 60s
			}
		}
	}
}
