# ============================================================================
#  NextAdmin — 本地开发环境变量示例
# ============================================================================
#
#  使用方法：
#    1. 复制此文件为 .env.local → cp .env.example.local .env.local
#    2. 替换所有 CHANGE_ME_* 占位符为实际值
#
#  安全提示：
#    - .env.local 包含真实密钥，**禁止**提交到 Git
#    - .env.example.local 仅含占位符，可以安全提交
#
# ============================================================================


# ============================================================================
#  §1  运行环境
# ============================================================================

NODE_ENV=development


# ============================================================================
#  §2  数据库
# ============================================================================
#
#  本地开发默认使用 Prisma + MySQL。
#
#  切换到 Supabase 时：
#    DATABASE_PROVIDER=supabase
#    并配置 §3 中的 SUPABASE_* 变量
#
#  推荐默认值：
#    DATABASE_URL=mysql://user:password@127.0.0.1:3306/edu_mini_app
# ----------------------------------------------------------------------------
DATABASE_PROVIDER=prisma
DATABASE_URL=mysql://root:password@127.0.0.1:3306/edu_mini_app

# ============================================================================
#  §3  Supabase（服务端）
# ============================================================================
# --- 服务端密钥（仅后端使用，禁止暴露到前端） ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=sb_secret_CHANGE_ME
# --- 客户端密钥（NEXT_PUBLIC_ 前缀会暴露到浏览器） ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_CHANGE_ME

# ============================================================================
#  §4  认证 — JWT & Session
# ============================================================================
# --- 密钥（⚠️ 生产环境必须替换为强随机值，≥ 32 字符） ---
AUTH_JWT_ACCESS_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHARS_OR_MORE_SECRET
AUTH_REFRESH_TOKEN_PEPPER=CHANGE_ME_TO_A_RANDOM_32_CHARS_OR_MORE_SECRET
# --- Token 有效期 ---
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=1296000
# --- 会话 & 安全策略 ---
AUTH_MAX_SESSIONS_PER_USER=3
AUTH_LOGIN_LOCK_THRESHOLD=10
AUTH_LOGIN_LOCK_DURATION_SECONDS=600
# --- Cookie & CORS ---
AUTH_COOKIE_SAMESITE=lax
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# AUTH_COOKIE_DOMAIN=                        # 可选，仅在跨子域共享 Cookie 时设置
# --- 内部请求（SSRF 防护） ---
INTERNAL_BASE_URL=http://localhost:3000       # middleware 内部刷新 session 的基础 URL

# ============================================================================
#  §5  多因素认证（MFA / TOTP）
# ============================================================================
MFA_SECRET_ENCRYPTION_KEY=CHANGE_ME_TO_A_RANDOM_32_CHARS_OR_MORE_SECRET
TOTP_SERVICE_NAME="GenericAdmin"            # Authenticator App 中显示的服务名
TOTP_ISSUER="GenericAdmin Admin"            # 发行者名称
TOTP_DIGITS=6                               # 验证码位数
TOTP_STEP=30                                # 时间窗口（秒）
MFA_ACTION_TOKEN_TTL=300                    # 有效期（秒），默认 5 分钟
# MFA_SKIP_ENABLED=false                    # ⚠️ 本地开发跳过 MFA（仅非生产环境生效）

# ============================================================================
#  §6  微信小程序
# ============================================================================
#
#  用于 /api/v1/auth/wechat 接口
# ----------------------------------------------------------------------------

WECHAT_APPID=
WECHAT_APPSECRET=
# session_key 加密密钥（⚠️ ≥ 32 字符）
WECHAT_SESSION_KEY_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_32_CHARS_OR_MORE_SECRET


# ============================================================================
#  §7  微信支付
# ============================================================================
#
#  用于小程序支付 & 回调处理
#  文档参考：https://pay.weixin.qq.com/wiki/doc/apiv3/wxpay/pages/index.shtml
# ----------------------------------------------------------------------------

# --- 基础配置 ---
WECHAT_PAY_APPID=                           # 小程序支付 appid（为空时回退 WECHAT_APPID）
WECHAT_PAY_MCHID=                           # 商户号
WECHAT_PAY_API_V3_KEY=                      # APIv3 密钥

# --- 商户证书（签名验签） ---
WECHAT_PAY_CERT_SERIAL=                     # 商户 API 证书序列号
WECHAT_PAY_PRIVATE_KEY_PEM=                 # 商户 API 私钥 PEM（支持 \n 存储）

# --- 微信支付公钥（公钥模式验签） ---
WECHAT_PAY_PUBLIC_KEY=                      # 公钥 PEM（支持 \n 存储）
WECHAT_PAY_PUBLIC_KEY_ID=                   # 公钥 ID，形如 PUB_KEY_ID_xxx
# WECHAT_PAY_PUBLIC_KEYS_JSON=             # 可选，JSON 数组，用于证书/公钥轮换
#   示例: [{"serial":"PUB_KEY_ID_1","publicKeyPem":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"}]

# --- 回调 ---
WECHAT_PAY_NOTIFY_URL=                      # 支付成功回调地址


# ============================================================================
#  §8  初始管理员种子数据
# ============================================================================
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================================================
#  §9  日志系统
# ============================================================================
LOG_LEVEL=debug                             # 日志级别: debug | info | warn | error
LOG_DIR=./logs                              # 日志文件目录
LOG_TO_STDOUT=false                         # 是否输出到 stdout（默认关闭，避免干扰 Next.js）
LOG_ROTATE_SIZE_BYTES=10485760              # 单文件最大 10 MB
LOG_ROTATE_DAILY=true                       # 按日轮转
LOG_RETENTION_DAYS=7                        # 保留最近 7 天
LOG_RETENTION_MAX_TOTAL_BYTES=1073741824    # 总日志最大 1 GB
LOG_HTTP_DETAILS_ENABLED=false              # 记录 HTTP 请求/响应详情（含脱敏）

# ============================================================================
#  §10  限流（Rate Limit）
# ============================================================================
RATE_LIMIT_TRUST_PROXY=false                # 是否信任反向代理 IP 头（X-Forwarded-For）
RATE_LIMIT_ALLOW_PRIVATE_IP=false           # 是否允许内网 IP（192.168.x.x, 10.x.x.x）
RATE_LIMIT_REQUIRE_IP=true                  # 无法获取 IP 时是否拒绝请求

# ============================================================================
#  §11  业务插件开关
# ============================================================================
PLUGIN_WECHAT=false                         # 微信小程序相关功能
PLUGIN_ECOMMERCE=false                      # 电商/商城模块
PLUGIN_PROMOTION=false                      # 营销/促销模块

# ============================================================================
#  §12  SEO & 站点配置
# ============================================================================
#
#  NEXT_PUBLIC_SITE_URL — 生产环境的完整站点 URL（不含尾部斜杠）
#  用于生成 canonical URL、sitemap、OpenGraph 链接等
#  本地开发可留空，默认回退 http://localhost:3000
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_NAME=NextAdmin                       # 品牌名称（登录页、侧边栏、SEO title）
