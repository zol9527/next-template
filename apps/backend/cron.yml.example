# Vercel Cron Jobs 配置
#
# 此文件用于配置 Vercel 的定时任务
#
# 使用方式：
# 1. 将此文件复制到项目根目录
# 2. 在 .env 中设置 CRON_SECRET
# 3. 部署到 Vercel
#
# Cron 表达式格式：
# - * * * * * *
# - │ │ │ │ │
# - │ │ │ │ └─ 星期几 (0-6, 0 = 周日)
# - │ │ │ └─── 月份 (1-12)
# - │ │ └───── 日期 (1-31)
# - │ └─────── 小时 (0-23)
# - └───────── 分钟 (0-59)
#
# 示例：
# - * * * * *: 每分钟
# - 0 * * * *: 每小时
# - 0 0 * * *: 每天 0 点
# - 0 0 * * 0: 每周日 0 点

# Rate Limit 计数器清理任务
# 每小时执行一次，清理过期的计数器记录
# URL: /api/v1/internal/rate-limit/cleanup
# 文档: docs/guides/rate-limit-usage.md

# 取消下面的注释以启用定时任务
# [cron.jobs.cleanup-rate-limit-counters]
# schedule = "0 * * * *"
# command = "curl -X POST https://your-domain.com/api/v1/internal/rate-limit/cleanup -H 'Authorization: Bearer $CRON_SECRET'"
